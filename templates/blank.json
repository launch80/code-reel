{
  "_comment": "MODE 3 — fill in every <SLOT>. Keep dur values on the beat grid (0.5s steps at 120bpm), keep intro <= 54 chars, card sub <= 33 chars, last scene stays endcard. Then: python3 validate.py blank.json && python3 audio.py && python3 render.py stills 0.8,3.4,5.6,8.5,11.9,14.0 && python3 render.py video && ./build.sh",
  "name": "<REEL_NAME>",
  "w": 1920,
  "h": 1080,
  "fps": 60,
  "bpm": 120,
  "theme": {
    "accent": "#e85d04",
    "hot": "#ff8a3d",
    "bg": "#0b0b0c",
    "cream": "#faf9f7"
  },
  "hud": {
    "brand": "<BRAND>",
    "brand2": "<BRAND_SUFFIX>",
    "series": "<SERIES_LABEL>",
    "line": "<TAGLINE_UPPERCASE>"
  },
  "timeline": [
    {
      "scene": "terminal",
      "dur": 1.5,
      "name": "BOOT",
      "p": {
        "prompt": "<USER>:~$",
        "cmd": "./<WHAT_YOU_BUILT> --<FLAG1> --<FLAG2>",
        "title": "zsh — 1920×1080",
        "rows": [
          ["<FACT_LABEL_1>", "<FACT_VALUE_1>"],
          ["<FACT_LABEL_2>", "<FACT_VALUE_2>"],
          ["<FACT_LABEL_3>", "<FACT_VALUE_3>"],
          ["<FACT_LABEL_4>", "<FACT_VALUE_4>"]
        ],
        "progress": { "label": "booting", "pct": 100 }
      }
    },
    {
      "scene": "kinetic",
      "dur": 2.5,
      "name": "KINETIC",
      "p": {
        "intro": "<ONE LINE OF SETUP, <= 54 chars>",
        "words": [
          ["<WORD_1>", 0.5, "", "<SMALL_NOTE_1>", "<STAT_1>"],
          ["<WORD_2>", 1.0, "", "<SMALL_NOTE_2>", "<STAT_2>"],
          ["<WORD_3>", 1.5, "ACCENT", "<SMALL_NOTE_3>", "<STAT_3>"]
        ]
      }
    },
    {
      "scene": "cards",
      "dur": 3.0,
      "name": "<SCENE_NAME>",
      "p": {
        "header": "// <HEADER, UPPERCASE>",
        "kicker": "<ONE LINE>",
        "cards": [
          {
            "tag": "<TAG_1>",
            "big": { "from": 0, "to": 100, "fmt": "int" },
            "unit": "<UNIT>",
            "sub": "<ONE LINE, <= 33 chars>",
            "label": "<ONE LINE>",
            "viz": "bars"
          },
          {
            "tag": "<TAG_2>",
            "big": { "from": 1, "to": 2.5, "fmt": "x" },
            "unit": "smaller",
            "sub": "<ONE LINE, <= 33 chars>",
            "label": "<ONE LINE>",
            "viz": "kv"
          },
          {
            "tag": "<TAG_3>",
            "big": { "from": 0, "to": 262, "fmt": "k" },
            "unit": "<UNIT>",
            "sub": "<ONE LINE, <= 33 chars>",
            "label": "<ONE LINE>",
            "viz": "ctx"
          }
        ],
        "ticker": { "label": "<LABEL>", "items": ["<ITEM_1>", "<ITEM_2>", "<ITEM_3>"] }
      }
    },
    {
      "scene": "counter",
      "dur": 3.0,
      "name": "<SCENE_NAME>",
      "p": {
        "prompt": "~/dir $",
        "promptArg": "<CHANNEL_OR_HANDLE>",
        "kicker": "<ONE LINE>",
        "big": { "from": 0, "to": 100, "fmt": "int" },
        "unit": "<UNIT>",
        "sub": "<SUB, UPPERCASE>",
        "tagline": "<TAGLINE>",
        "typing": "<QUOTE_PEOPLE_SAID>"
      }
    },
    {
      "scene": "chart",
      "dur": 2.5,
      "name": "<SCENE_NAME>",
      "p": {
        "line": "<ONE LINE>",
        "grow": [0, 25, 50, 100, 175, 275, 400, 550],
        "max": 550,
        "months": ["FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP"],
        "label": "<LABEL>",
        "sub": "<SOURCE LINE>",
        "impact": 1.8,
        "seed": 1
      }
    },
    {
      "scene": "endcard",
      "dur": 2.5,
      "name": "<BRAND>",
      "p": {
        "tag": "<UPPERCASE TAG LINE>",
        "word1": "<BRAND>",
        "word2": "<BRAND_SUFFIX>",
        "serif": "<lowercase serif line>",
        "url": "<your.site>",
        "footer": "<REEL TYPE> · <YEAR>"
      }
    }
  ]
}
